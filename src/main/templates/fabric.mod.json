{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${modVersion}",
	"name": "${modDisplayName}",
	"description": "${modDescription}",
	"authors": [
		"${modAuthors}"
	],
	"contact": {
		"homepage": "${modDisplayUrl}",
		"issues": "${modIssueUrl}"
	},
	"license": "${modLicense}",
	"icon": "icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.forgestove.create_cyber_goggles.CCG"
		],
		"modmenu": [
			"io.github.forgestove.create_cyber_goggles.CCGModMenu"
		]
	},
	"mixins": [
		"create_cyber_goggles.mixins.json"
	],
	"depends": {
		"fabric-api": "*",
		"fabricloader": "*",
		"minecraft": "*",
		"create": "*"
	},
	"suggests": {
		"modmenu": "*",
		"jei": "*"
	}
}
